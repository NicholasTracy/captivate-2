{
  "format": "captivate-theme",
  "version": 1,
  "id": "ocean",
  "name": "Ocean",
  "description": "Cool blue night look — example custom theme.",
  "extends": "captivate",
  "mode": "dark",
  "colors": {
    "bg": {
      "primary": "#0a1628",
      "darker": "#060e1a",
      "lighter": "#122038",
      "panel": "#152844",
      "raised": "#1a3254"
    },
    "divider": "rgba(140, 180, 220, 0.35)",
    "accent": "#6ec8ff",
    "accentMuted": "rgba(110, 200, 255, 0.22)",
    "text": {
      "primary": "#e8f4ff",
      "secondary": "#a8c4dc",
      "error": "#ff8a8a",
      "warning": "#ffd080"
    },
    "icon": {
      "primary": "rgba(232, 244, 255, 0.94)",
      "secondary": "rgba(168, 196, 220, 0.88)"
    },
    "button": {
      "text": "rgba(232, 244, 255, 0.94)",
      "textMuted": "rgba(232, 244, 255, 0.8)",
      "icon": "rgba(232, 244, 255, 0.9)"
    }
  },
  "elevation": {
    "shadowSm": "0 1px 2px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 20, 40, 0.45)",
    "shadowMd": "0 6px 20px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 20, 40, 0.4)",
    "shadowSidebar": "4px 0 24px rgba(0, 10, 30, 0.55)",
    "insetHighlight": "inset 0 1px 0 rgba(180, 220, 255, 0.12)",
    "insetDepth": "inset 0 2px 10px rgba(0, 0, 0, 0.55)"
  },
  "mui": {
    "fieldBg": "#0a1420",
    "outline": "rgba(140, 180, 220, 0.4)",
    "paper": "#122038",
    "default": "#0a1628",
    "placeholder": "rgba(168, 196, 220, 0.55)",
    "label": "rgba(232, 244, 255, 0.78)"
  }
}
